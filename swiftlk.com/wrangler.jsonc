{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "swiftlk-site",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "not_found_handling": "404-page" },
  "workers_dev": true,
  // Add custom domains here once the domain is on this Cloudflare account, e.g.
  // "routes": [{ "pattern": "swiftlk.com", "custom_domain": true }]
}
